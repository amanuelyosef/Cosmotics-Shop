rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection rules:
    // Public read access for customer storefront website.
    // Write access allowed for inventory management and initial seeding.
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Default fallback rule for any other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
